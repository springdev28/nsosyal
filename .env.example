# ---------------------------------------------------------------------------
# nSosyal 5N - ornek ortam degiskenleri
# Bu dosyayi .env.local olarak kopyalayin. Gercek anahtarlari repoya commitlemeyin.
# ---------------------------------------------------------------------------

# DEMO_MODE=true iken uygulama tamamen sentetik seed verisiyle, hicbir dis
# servise baglanmadan calisir. Yarisma demosunun internet/servis kesintisine
# dayanikli olmasi icin varsayilan budur (bkz. PROJECT_SPEC "Demo dayanikliligi").
DEMO_MODE=true

# Uygulamanin kendi adresi (mutlak baglantilar ve OG etiketleri icin).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase (DEMO_MODE=false iken zorunlu)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# UYARI: service role anahtari yalnizca sunucu tarafinda kullanilir.
# Asla NEXT_PUBLIC_ onekiyle tanimlamayin ve asla client bundle icine koymayin.
SUPABASE_SERVICE_ROLE_KEY=
